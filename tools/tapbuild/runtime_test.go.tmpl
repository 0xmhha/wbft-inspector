type wbftTapTestRW struct {
	msg                  Msg
	err                  error
	readPayload          []byte
	reads                int
	writeStart, writeEnd time.Time
}

func (w *wbftTapTestRW) ReadMsg() (Msg, error) { w.reads++; return w.msg, w.err }
func (w *wbftTapTestRW) WriteMsg(msg Msg) error {
	w.writeStart = time.Now()
	defer func() { w.writeEnd = time.Now() }()
	b, e := io.ReadAll(msg.Payload)
	w.readPayload = b
	if w.err != nil {
		return w.err
	}
	return e
}

func wbftTapTestWriter(t *testing.T) *wbftTapWriter {
	t.Helper()
	dir := t.TempDir()
	if e := os.Chmod(dir, 0700); e != nil {
		t.Fatal(e)
	}
	w, e := wbftTapOpen(dir, "0x0000000000000000000000000000000000000001")
	if e != nil {
		t.Fatal(e)
	}
	return w
}
func wbftTapTestRecords(t *testing.T, w *wbftTapWriter) []map[string]any {
	t.Helper()
	if err := w.close(); err != nil {
		t.Fatal(err)
	}
	raw, e := os.ReadFile(w.file.Name())
	if e != nil {
		t.Fatal(e)
	}
	out := []map[string]any{}
	for _, line := range bytes.Split(bytes.TrimSpace(raw), []byte("\n")) {
		if len(line) == 0 {
			continue
		}
		var x map[string]any
		if e = json.Unmarshal(line, &x); e != nil {
			t.Fatal(e)
		}
		out = append(out, x)
	}
	return out
}

func TestWBFTTapDisabledPreservesRWIdentity(t *testing.T) {
	t.Setenv("WBFT_TAP_DIR", "")
	rw := &wbftTapTestRW{}
	got, close, e := WBFTTapStream(rw, nil)
	if e != nil || got != rw || rw.reads != 0 {
		t.Fatal("disabled tap changed reader/writer", e)
	}
	close()
}

func TestWBFTTapReadDoesNotConsumeBeforeCaller(t *testing.T) {
	w := wbftTapTestWriter(t)
	body := bytes.NewBufferString("wire")
	rw := &wbftTapTestRW{msg: Msg{Code: 0x13, Size: 4, Payload: body}}
	s := &wbftTapStream{base: rw, writer: w, peer: "0x0000000000000000000000000000000000000002", pending: map[*wbftTapReader]bool{}}
	msg, e := s.ReadMsg()
	if e != nil || body.Len() != 4 {
		t.Fatal("tap eagerly consumed payload", e)
	}
	raw, e := io.ReadAll(msg.Payload)
	if e != nil || string(raw) != "wire" {
		t.Fatal(raw, e)
	}
	s.close()
	records := wbftTapTestRecords(t, w)
	if len(records) != 2 || records[0]["type"] != "frame" || records[0]["outcome"] != "PENDING" || records[1]["event"] != "closed" {
		t.Fatal(records)
	}
	hash := records[0]["payload_sha256"].(string)
	stored, e := os.ReadFile(filepath.Join(w.root, "payloads", hash[:2], hash))
	if e != nil || !bytes.Equal(stored, raw) {
		t.Fatal("captured payload differs", e)
	}
}

func TestWBFTTapWritePreservesBytesAndError(t *testing.T) {
	for _, fail := range []bool{false, true} {
		w := wbftTapTestWriter(t)
		sentinel := errors.New("original write failure")
		rw := &wbftTapTestRW{}
		if fail {
			rw.err = sentinel
		}
		s := &wbftTapStream{base: rw, writer: w, peer: "0x0000000000000000000000000000000000000002"}
		e := s.WriteMsg(Msg{Code: 0x13, Size: 4, Payload: bytes.NewBufferString("wire")})
		if !bytes.Equal(rw.readPayload, []byte("wire")) || fail && e != sentinel || !fail && e != nil {
			t.Fatal("tap changed write", e)
		}
		records := wbftTapTestRecords(t, w)
		want := "ok"
		if fail {
			want = "error"
		}
		if len(records) != 1 || records[0]["write_result"] != want {
			t.Fatal(records)
		}
	}
}

func TestWBFTTapPartialAndOversizedPayloadStayUnavailable(t *testing.T) {
	for _, size := range []uint32{4, wbftTapPayloadLimit + 1} {
		w := wbftTapTestWriter(t)
		rw := &wbftTapTestRW{msg: Msg{Code: 0x13, Size: size, Payload: bytes.NewBufferString("x")}}
		s := &wbftTapStream{base: rw, writer: w, peer: "0x0000000000000000000000000000000000000002", pending: map[*wbftTapReader]bool{}}
		msg, e := s.ReadMsg()
		if e != nil {
			t.Fatal(e)
		}
		_, e = io.ReadAll(msg.Payload)
		if e != nil {
			t.Fatal(e)
		}
		s.close()
		records := wbftTapTestRecords(t, w)
		if _, ok := records[0]["payload_sha256"]; ok {
			t.Fatal("invented complete payload", records)
		}
		if records[0]["io"] != nil {
			t.Fatal("partial read invented a completed interval", records)
		}
		if records[0]["size"] != float64(size) || w.incomplete != 1 {
			t.Fatal(records)
		}
	}
}

func TestWBFTTapOverflowReportsDroppedRecords(t *testing.T) {
	w := wbftTapTestWriter(t)
	w.emit(map[string]any{"type": "frame"}, make([]byte, wbftTapPayloadLimit+1), true)
	records := wbftTapTestRecords(t, w)
	if len(records) != 1 || records[0]["type"] != "dropped" || records[0]["count"] != float64(1) {
		t.Fatal("overflow hidden", records)
	}
}

func TestWBFTTapConcurrentCloseAndPrivatePaths(t *testing.T) {
	w := wbftTapTestWriter(t)
	var group sync.WaitGroup
	for range 8 {
		group.Add(1)
		go func() {
			defer group.Done()
			if e := w.close(); e != nil {
				t.Error(e)
			}
		}()
	}
	group.Wait()
	root := t.TempDir()
	if e := os.Chmod(root, 0700); e != nil {
		t.Fatal(e)
	}
	link := filepath.Join(root, "link")
	if e := os.Symlink(w.root, link); e != nil {
		t.Fatal(e)
	}
	if _, e := wbftTapOpen(link, w.node); e == nil {
		t.Fatal("symlink recording root accepted")
	}
}

func TestWBFTTapWriteIntervalBracketsOriginalCall(t *testing.T) {
	w := wbftTapTestWriter(t)
	rw := &wbftTapTestRW{}
	s := &wbftTapStream{base: rw, writer: w, peer: "0x0000000000000000000000000000000000000002"}
	if err := s.WriteMsg(Msg{Code: 0x13, Size: 4, Payload: bytes.NewBufferString("wire")}); err != nil {
		t.Fatal(err)
	}
	records := wbftTapTestRecords(t, w)
	x, ok := records[0]["io"].(map[string]any)
	if !ok {
		t.Fatal("I/O evidence missing", records)
	}
	start, err := time.Parse(time.RFC3339Nano, x["start_wall"].(string))
	if err != nil {
		t.Fatal(err)
	}
	end, err := time.Parse(time.RFC3339Nano, x["end_wall"].(string))
	if err != nil {
		t.Fatal(err)
	}
	if start.After(rw.writeStart) || end.Before(rw.writeEnd) || x["start_mono_ns"].(float64) < 0 || x["end_mono_ns"].(float64) < x["start_mono_ns"].(float64) || x["end_mono_ns"].(float64) > records[0]["t_mono_ns"].(float64) {
		t.Fatal("interval replaced by observer/file-write time", x)
	}
}

func wbftTapObservationRecords(t *testing.T, w *wbftTapWriter) []map[string]any {
	t.Helper()
	if err := w.close(); err != nil {
		t.Fatal(err)
	}
	raw, err := os.ReadFile(w.observations.Name())
	if err != nil {
		t.Fatal(err)
	}
	var rows []map[string]any
	for _, line := range bytes.Split(bytes.TrimSpace(raw), []byte("\n")) {
		if len(line) == 0 {
			continue
		}
		var r map[string]any
		if err := json.Unmarshal(line, &r); err != nil {
			t.Fatal(err)
		}
		rows = append(rows, r)
	}
	return rows
}

func TestWBFTTapObservationsKeepIndependentSequenceAndCallBoundary(t *testing.T) {
	w := wbftTapTestWriter(t)
	start := time.Now()
	w.observe("operation_start", start, map[string]any{"id": uint64(1), "operation": "insert_chain"})
	w.emit(map[string]any{"type": "conn"}, nil, false)
	o := &WBFTTapOperation{writer: w, id: 1}
	returnBefore := time.Now()
	o.EndError(errors.New("original import error"), "17", "0x123", 2)
	returnAfter := time.Now()
	o.End("ok", "18", "", 0)
	rows := wbftTapObservationRecords(t, w)
	if len(rows) != 3 || rows[0]["seq"] != float64(0) || rows[1]["seq"] != float64(1) || rows[2]["seq"] != float64(2) || rows[1]["result"] != "error" || rows[2]["type"] != "capture_end" {
		t.Fatal(rows)
	}
	end, err := time.Parse(time.RFC3339Nano, rows[1]["t_wall"].(string))
	if err != nil {
		t.Fatal(err)
	}
	if end.Before(returnBefore) || end.After(returnAfter) || rows[1]["t_mono_ns"].(float64) < rows[0]["t_mono_ns"].(float64) {
		t.Fatal("call boundary changed", rows)
	}
	frames := wbftTapTestRecords(t, w)
	if len(frames) != 1 || frames[0]["seq"] != float64(0) {
		t.Fatal("observation consumed a frame sequence", frames)
	}
	info, err := os.Stat(w.observations.Name())
	if err != nil || info.Mode().Perm() != 0600 {
		t.Fatal(info, err)
	}
}

func TestWBFTTapObservationOverflowRemainsVisible(t *testing.T) {
	w := wbftTapTestWriter(t)
	w.observe("operation_start", time.Now(), map[string]any{"oversize": string(make([]byte, 64<<10))})
	rows := wbftTapObservationRecords(t, w)
	if len(rows) != 1 || rows[0]["type"] != "capture_end" || rows[0]["dropped"] != float64(1) || rows[0]["seq"] != float64(1) {
		t.Fatal("observation gap hidden", rows)
	}
}

func TestWBFTTapObservationDisabledAndFailedOpen(t *testing.T) {
	t.Setenv("WBFT_TAP_DIR", "")
	if o := WBFTTapBegin("insert_chain", "17", "", 1); o != nil {
		t.Fatal("disabled observation created an operation")
	}
	var o *WBFTTapOperation
	o.End("ok", "", "", 0)
	o.EndError(nil, "", "", 0)
	wbftTapGlobal.Lock()
	oldW, oldErr := wbftTapGlobal.writer, wbftTapGlobal.err
	wbftTapGlobal.writer = nil
	wbftTapGlobal.err = nil
	wbftTapGlobal.Unlock()
	defer func() {
		wbftTapGlobal.Lock()
		wbftTapGlobal.writer = oldW
		wbftTapGlobal.err = oldErr
		wbftTapGlobal.Unlock()
	}()
	t.Setenv("WBFT_TAP_DIR", "relative/unsafe")
	t.Setenv("WBFT_TAP_NODE", "0x0000000000000000000000000000000000000001")
	if WBFTTapBegin("insert_chain", "17", "", 1) != nil {
		t.Fatal("invalid path opened")
	}
	if WBFTTapClose() == nil {
		t.Fatal("failed observation setup hidden at flush")
	}
}

func TestWBFTTapStagesKeepExactRequestAcrossCopiesAndClose(t *testing.T) {
 root:=t.TempDir();if err:=os.Chmod(root,0700);err!=nil{t.Fatal(err)}
 w,err:=wbftTapOpen(root,"0x1111111111111111111111111111111111111111");if err!=nil{t.Fatal(err)}
 op:=&WBFTTapOperation{writer:w,id:9}
 copy:=op
 copy.Stage("seal_return","1","0x"+strings.Repeat("2",64))
 op.Stage("request_post_enter","1","0x"+strings.Repeat("2",64))
 copy.Stage("seal_cancel","1","0x"+strings.Repeat("2",64))
 if err=w.close();err!=nil{t.Fatal(err)}
 // Late callbacks retain the closed writer instead of moving to a new run.
 copy.Stage("seal_result","1","0x"+strings.Repeat("2",64))
 data,err:=os.ReadFile(filepath.Join(root,"observations-"+w.run+".jsonl"));if err!=nil{t.Fatal(err)}
 if bytes.Count(data,[]byte(`"type":"operation_stage"`))!=3||bytes.Count(data,[]byte(`"id":9`))!=3||bytes.Contains(data,[]byte(`"stage":"seal_result"`)){t.Fatal(string(data))}
 var disabled *WBFTTapOperation;disabled.Stage("seal_enter",""," ")
}
