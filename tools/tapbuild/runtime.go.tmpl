const wbftTapPayloadLimit = 10 << 20
const wbftTapQueueBytes = 32 << 20

type wbftTapItem struct {
	record      map[string]any
	payload     []byte
	complete    bool
	observation bool
	bytes       int
}
type wbftTapWriter struct {
	mu                                              sync.Mutex
	root, node, run                                 string
	start                                           time.Time
	file                                            *os.File
	observations                                    *os.File
	observationSeq, observationDropped, operationID uint64
	queue                                           chan wbftTapItem
	done                                            chan struct{}
	closeDone                                       chan struct{}
	closeOnce                                       sync.Once
	closed                                          bool
	seq, dropped, incomplete                        uint64
	queuedBytes                                     int
	err                                             error
}

var wbftTapGlobal struct {
	sync.Mutex
	writer *wbftTapWriter
	err    error
}

func wbftTapOpen(root, node string) (*wbftTapWriter, error) {
	node = strings.ToLower(node)
	if len(node) != 42 || !strings.HasPrefix(node, "0x") {
		return nil, errors.New("tap: invalid recording node")
	}
	if _, err := hex.DecodeString(node[2:]); err != nil {
		return nil, errors.New("tap: invalid recording node")
	}
	if !filepath.IsAbs(root) {
		return nil, errors.New("tap: absolute private directory required")
	}
	if err := os.Mkdir(root, 0700); err != nil && !os.IsExist(err) {
		return nil, err
	}
	info, err := os.Lstat(root)
	if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
		return nil, errors.New("tap: private directory required")
	}
	start := time.Now()
	run := fmt.Sprintf("tap-%d-%d", os.Getpid(), start.UnixNano())
	f, err := os.OpenFile(filepath.Join(root, "frames-"+run+".jsonl"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
	if err != nil {
		return nil, err
	}
	observations, err := os.OpenFile(filepath.Join(root, "observations-"+run+".jsonl"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
	if err != nil {
		f.Close()
		return nil, err
	}
	w := &wbftTapWriter{root: root, node: node, run: run, start: start, file: f, observations: observations, queue: make(chan wbftTapItem, 1024), done: make(chan struct{}), closeDone: make(chan struct{})}
	go w.work()
	return w, nil
}

func wbftTapGet() (*wbftTapWriter, error) {
	root := os.Getenv("WBFT_TAP_DIR")
	if root == "" {
		return nil, nil
	}
	wbftTapGlobal.Lock()
	defer wbftTapGlobal.Unlock()
	if wbftTapGlobal.writer == nil {
		w, err := wbftTapOpen(root, os.Getenv("WBFT_TAP_NODE"))
		if err != nil {
			wbftTapGlobal.err = errors.Join(wbftTapGlobal.err, err)
			return nil, err
		}
		wbftTapGlobal.writer = w
	}
	return wbftTapGlobal.writer, nil
}

func (w *wbftTapWriter) emit(record map[string]any, payload []byte, complete bool) {
	w.mu.Lock()
	defer w.mu.Unlock()
	if w.closed {
		return
	}
	now := time.Now()
	record["v"], record["node"], record["run"] = 1, w.node, w.run
	record["seq"], record["t_wall"], record["t_mono_ns"] = w.seq, now.UTC().Format(time.RFC3339Nano), now.Sub(w.start).Nanoseconds()
	w.seq++
	if len(payload) > wbftTapPayloadLimit || w.queuedBytes+len(payload) > wbftTapQueueBytes || len(w.queue) == cap(w.queue) {
		w.dropped++
		return
	}
	if record["type"] == "frame" && !complete {
		w.incomplete++
	}
	w.queuedBytes += len(payload)
	w.queue <- wbftTapItem{record: record, payload: append([]byte(nil), payload...), complete: complete, bytes: len(payload)}
}

func (w *wbftTapWriter) write(item wbftTapItem) error {
	if item.complete && item.record["type"] == "frame" {
		sum := sha256.Sum256(item.payload)
		name := hex.EncodeToString(sum[:])
		for _, dir := range []string{filepath.Join(w.root, "payloads"), filepath.Join(w.root, "payloads", name[:2])} {
			if err := os.Mkdir(dir, 0700); err != nil && !os.IsExist(err) {
				return err
			}
			info, err := os.Lstat(dir)
			if err != nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || info.Mode().Perm()&0077 != 0 {
				return errors.New("tap: unsafe payload directory")
			}
		}
		dir := filepath.Join(w.root, "payloads", name[:2])
		path := filepath.Join(dir, name)
		f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
		if os.IsExist(err) {
			info, statErr := os.Lstat(path)
			if statErr != nil || !info.Mode().IsRegular() || info.Mode().Perm()&0077 != 0 {
				return errors.New("tap: unsafe existing payload")
			}
			old, readErr := os.ReadFile(path)
			if readErr != nil || !bytes.Equal(old, item.payload) {
				return errors.New("tap: existing payload differs")
			}
		} else if err != nil {
			return err
		} else {
			_, writeErr := f.Write(item.payload)
			syncErr := f.Sync()
			closeErr := f.Close()
			if err = errors.Join(writeErr, syncErr, closeErr); err != nil {
				return err
			}
		}
		item.record["payload_sha256"] = name
		encoded, err := rlp.EncodeToBytes(item.payload)
		if err != nil {
			return err
		}
		item.record["dedup_key"] = "0x" + hex.EncodeToString(crypto.Keccak256(encoded))
	}
	raw, err := json.Marshal(item.record)
	if err != nil {
		return err
	}
	file := w.file
	if item.observation {
		file = w.observations
	}
	_, err = file.Write(append(raw, '\n'))
	return err
}

func (w *wbftTapWriter) work() {
	defer close(w.done)
	for item := range w.queue {
		if w.err == nil {
			w.err = w.write(item)
		}
		w.mu.Lock()
		w.queuedBytes -= item.bytes
		w.mu.Unlock()
	}
}

func (w *wbftTapWriter) close() error {
	w.closeOnce.Do(func() {
		defer close(w.closeDone)
		w.mu.Lock()
		w.closed = true
		close(w.queue)
		w.mu.Unlock()
		<-w.done
		if w.dropped > 0 && w.err == nil {
			now := time.Now()
			record := map[string]any{"v": 1, "type": "dropped", "node": w.node, "run": w.run, "seq": w.seq, "t_wall": now.UTC().Format(time.RFC3339Nano), "t_mono_ns": now.Sub(w.start).Nanoseconds(), "count": w.dropped}
			w.err = w.write(wbftTapItem{record: record})
		}
		if w.err == nil {
			now := time.Now()
			r := w.observationRecord("capture_end", now)
			r["dropped"] = w.observationDropped
			w.err = w.write(wbftTapItem{record: r, observation: true})
		}
		w.err = errors.Join(w.err, w.file.Sync(), w.file.Close(), w.observations.Sync(), w.observations.Close())
	})
	<-w.closeDone
	return w.err
}

// WBFTTapClose flushes captured bytes when the CLI exits normally. A crash
// has no completeness claim; even a clean close does not prove delivery loss.
func WBFTTapClose() error {
	wbftTapGlobal.Lock()
	w := wbftTapGlobal.writer
	err := wbftTapGlobal.err
	wbftTapGlobal.Unlock()
	if w == nil {
		return err
	}
	return errors.Join(err, w.close())
}

type wbftTapStream struct {
	base         MsgReadWriter
	writer       *wbftTapWriter
	peer, peerID string
	offset       *uint64
	mu           sync.Mutex
	pending      map[*wbftTapReader]bool
}

// WBFTTapStream observes only the consensus protocol. Disabled capture returns
// the original reader/writer, preserving its identity and all operations.
func WBFTTapStream(rw MsgReadWriter, peer *Peer) (MsgReadWriter, func(), error) {
	w, err := wbftTapGet()
	if err != nil {
		return nil, nil, err
	}
	if w == nil {
		return rw, func() {}, nil
	}
	pub := peer.Node().Pubkey()
	if pub == nil {
		return nil, nil, errors.New("tap: peer public key unavailable")
	}
	s := &wbftTapStream{base: rw, writer: w, peer: strings.ToLower(crypto.PubkeyToAddress(*pub).Hex()), peerID: peer.ID().String(), pending: map[*wbftTapReader]bool{}}
	if protocol, ok := rw.(*protoRW); ok {
		n := protocol.offset
		s.offset = &n
	}
	w.emit(map[string]any{"type": "conn", "peer": s.peer, "peer_id": s.peerID, "event": "istanbul_attached"}, nil, false)
	return s, s.close, nil
}

type wbftTapIO struct{ start, end time.Time }

func (s *wbftTapStream) frame(msg Msg, dir string, raw []byte, complete bool, write string, span *wbftTapIO) {
	var wire any
	if s.offset != nil {
		wire = msg.Code + *s.offset
	}
	r := map[string]any{"type": "frame", "dir": dir, "peer": s.peer, "peer_id": s.peerID, "code": fmt.Sprintf("0x%x", msg.Code), "wire_code": wire, "size": int64(msg.Size), "dedup_key": ""}
	if dir == "in" {
		r["outcome"] = "PENDING"
	} else {
		r["write_result"] = write
		if write != "ok" {
			r["write_error"] = "error"
		}
	}
	if span != nil {
		r["io"] = map[string]any{"start_wall": span.start.UTC().Format(time.RFC3339Nano), "end_wall": span.end.UTC().Format(time.RFC3339Nano), "start_mono_ns": span.start.Sub(s.writer.start).Nanoseconds(), "end_mono_ns": span.end.Sub(s.writer.start).Nanoseconds()}
	}
	s.writer.emit(r, raw, complete)
}

func (s *wbftTapStream) ReadMsg() (Msg, error) {
	start := time.Now()
	msg, err := s.base.ReadMsg()
	end := time.Now()
	if err != nil {
		return msg, err
	}
	r := &wbftTapReader{source: msg.Payload, msg: msg, stream: s, ioStart: start, ioEnd: end}
	msg.Payload = r
	s.mu.Lock()
	s.pending[r] = true
	s.mu.Unlock()
	if msg.Size == 0 {
		r.finish()
	}
	return msg, nil
}

func (s *wbftTapStream) WriteMsg(msg Msg) error {
	r := &wbftTapReader{source: msg.Payload, msg: msg}
	forward := msg
	forward.Payload = r
	start := time.Now()
	err := s.base.WriteMsg(forward)
	end := time.Now()
	write := "ok"
	if err != nil {
		write = "error"
	}
	raw, complete := r.snapshot()
	s.frame(msg, "out", raw, complete, write, &wbftTapIO{start: start, end: end})
	return err
}

func (s *wbftTapStream) close() {
	s.mu.Lock()
	pending := make([]*wbftTapReader, 0, len(s.pending))
	for r := range s.pending {
		pending = append(pending, r)
	}
	s.mu.Unlock()
	for _, r := range pending {
		r.finish()
	}
	s.writer.emit(map[string]any{"type": "conn", "peer": s.peer, "peer_id": s.peerID, "event": "closed", "by": "unknown", "reason": "stream_ended"}, nil, false)
}

// Capture follows the existing reads. It never drains, replaces errors or
// interprets an engine outcome. Oversized or partial bytes stay unavailable.
type wbftTapReader struct {
	mu             sync.Mutex
	source         io.Reader
	msg            Msg
	stream         *wbftTapStream
	data           bytes.Buffer
	read           uint64
	finished       bool
	ioStart, ioEnd time.Time
}

func (r *wbftTapReader) complete() bool {
	return r.msg.Size <= wbftTapPayloadLimit && r.read == uint64(r.msg.Size)
}
func (r *wbftTapReader) Read(p []byte) (int, error) {
	r.mu.Lock()
	defer r.mu.Unlock()
	n, err := r.source.Read(p)
	r.ioEnd = time.Now()
	r.read += uint64(n)
	if r.msg.Size <= wbftTapPayloadLimit && r.data.Len()+n <= wbftTapPayloadLimit {
		_, _ = r.data.Write(p[:n])
	}
	if r.stream != nil && (r.read >= uint64(r.msg.Size) || err != nil) {
		r.finishLocked()
	}
	return n, err
}
func (r *wbftTapReader) finish() {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.finishLocked()
}
func (r *wbftTapReader) snapshot() ([]byte, bool) {
	r.mu.Lock()
	defer r.mu.Unlock()
	return append([]byte(nil), r.data.Bytes()...), r.complete()
}
func (r *wbftTapReader) finishLocked() {
	if r.finished {
		return
	}
	r.finished = true
	if r.stream != nil {
		var span *wbftTapIO
		if r.complete() {
			span = &wbftTapIO{start: r.ioStart, end: r.ioEnd}
		}
		r.stream.frame(r.msg, "in", r.data.Bytes(), r.complete(), "", span)
		r.stream.mu.Lock()
		delete(r.stream.pending, r)
		r.stream.mu.Unlock()
	}
}

// WBFTTapRuntimeConfig contains measured startup settings, not native engine
// options. Only public identities and scalar configuration are recorded.
type WBFTTapRuntimeConfig struct {
	Address, Height, RequestTimeoutMS, BlockPeriodSeconds, Epoch        string
	AllowedFutureBlockSeconds, MaxRequestTimeoutSeconds, ProposerPolicy string
	Transitions, SystemContractUpgrades                                 int
}

func wbftTapObservationWriter() *wbftTapWriter {
	w, _ := wbftTapGet() // Opening errors are retained for the CLI flush result.
	return w
}

func (w *wbftTapWriter) observationRecord(kind string, now time.Time) map[string]any {
	r := map[string]any{"v": 1, "type": kind, "node": w.node, "run": w.run, "seq": w.observationSeq,
		"t_wall": now.UTC().Format(time.RFC3339Nano), "t_mono_ns": now.Sub(w.start).Nanoseconds()}
	w.observationSeq++
	return r
}

func (w *wbftTapWriter) observe(kind string, now time.Time, fields map[string]any) {
	w.mu.Lock()
	defer w.mu.Unlock()
	if w.closed {
		return
	}
	r := w.observationRecord(kind, now)
	for key, value := range fields {
		r[key] = value
	}
	raw, err := json.Marshal(r)
	if err != nil || len(raw) > 64<<10 || w.queuedBytes+len(raw) > wbftTapQueueBytes || len(w.queue) == cap(w.queue) {
		w.observationDropped++
		return
	}
	w.queuedBytes += len(raw)
	w.queue <- wbftTapItem{record: r, observation: true, bytes: len(raw)}
}

// WBFTTapRuntimeStart samples the effective configuration for the explicitly
// recorded height. Configuration transitions after that height need new proof.
func WBFTTapRuntimeStart(c WBFTTapRuntimeConfig) {
	w := wbftTapObservationWriter()
	if w == nil {
		return
	}
	now := time.Now()
	if !strings.EqualFold(w.node, c.Address) {
		wbftTapGlobal.Lock()
		wbftTapGlobal.err = errors.Join(wbftTapGlobal.err, errors.New("tap: runtime identity differs from recording node"))
		wbftTapGlobal.Unlock()
		return
	}
	w.observe("runtime_start", now, map[string]any{"config": c})
}

func WBFTTapRuntimeStop(err error) {
	if w := wbftTapObservationWriter(); w != nil {
		now := time.Now()
		result := "ok"
		if err != nil {
			result = "error"
		}
		w.observe("runtime_stop", now, map[string]any{"result": result})
	}
}

// WBFTTapOperation records a real call boundary. It does not claim consensus
// request completion, successful sealing, canonical import or delivery coverage.
type WBFTTapOperation struct {
	writer *wbftTapWriter
	id     uint64
	once   sync.Once
}

func WBFTTapBegin(operation, height, hash string, count int) *WBFTTapOperation {
	w := wbftTapObservationWriter()
	if w == nil {
		return nil
	}
	now := time.Now()
	w.mu.Lock()
	w.operationID++
	id := w.operationID
	w.mu.Unlock()
	o := &WBFTTapOperation{writer: w, id: id}
	w.observe("operation_start", now, map[string]any{"id": id, "operation": operation, "height": height, "hash": hash, "count": count})
	return o
}

// End samples the return boundary before queueing or formatting observation data.
func (o *WBFTTapOperation) End(result, height, hash string, index int) {
	now := time.Now()
	if o == nil {
		return
	}
	o.once.Do(func() {
		o.writer.observe("operation_end", now, map[string]any{"id": o.id, "result": result, "height": height, "hash": hash, "index": index})
	})
}

func (o *WBFTTapOperation) EndError(err error, height, hash string, index int) {
	result := "ok"
	if err != nil {
		result = "error"
	}
	o.End(result, height, hash, index)
}

// WBFTTapEnabled lets source hooks avoid configuration and block reads when disabled.
func WBFTTapEnabled() bool { return os.Getenv("WBFT_TAP_DIR") != "" }

// WBFTTapRuntimeClose observes this pinned backend's no-op Close method.
// It deliberately does not emit a successful engine Stop event.
func WBFTTapRuntimeClose() {
	if w := wbftTapObservationWriter(); w != nil {
		w.observe("runtime_close", time.Now(), map[string]any{"engine_stopped": false})
	}
}

// Stage keeps the exact request token across task transfer and asynchronous
// sealing. A function return is distinct from result-channel completion.
func (o *WBFTTapOperation) Stage(stage, height, hash string) {
 if o == nil { return }
 o.writer.observe("operation_stage", time.Now(), map[string]any{"id":o.id,"stage":stage,"height":height,"hash":hash})
}
