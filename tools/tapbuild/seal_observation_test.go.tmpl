func TestWBFTTapSealImmediateReturnAndIndependentSameHashTokens(t *testing.T){
 root:=t.TempDir();if err:=os.Chmod(root,0700);err!=nil{t.Fatal(err)}
 t.Setenv("WBFT_TAP_DIR",root);t.Setenv("WBFT_TAP_NODE","0x1111111111111111111111111111111111111111")
 defer p2p.WBFTTapClose()
 backend:=&Backend{istanbulEventMux:new(event.TypeMux),commitCh:make(chan *types.Block)}
 sub:=backend.EventMux().Subscribe(wbft.RequestEvent{});defer sub.Unsubscribe()
 block:=types.NewBlockWithHeader(&types.Header{Number:big.NewInt(1)})
 before:=block.Hash()
 plainResult:=make(chan *types.Block,1);plainStop:=make(chan struct{});close(plainStop)
 if err:=backend.Seal(nil,block,plainResult,plainStop);err!=nil{t.Fatal(err)}
 select{case got:=<-plainResult:if got!=nil{t.Fatal("disabled cancellation changed")};case <-time.After(5*time.Second):t.Fatal("disabled cancellation absent")}
 select{case <-sub.Chan():case <-time.After(5*time.Second):t.Fatal("disabled post absent")}
 if files,_:=filepath.Glob(filepath.Join(root,"observations-*.jsonl"));len(files)!=0{t.Fatal("disabled seal created capture")}
 a:=p2p.WBFTTapBegin("worker_commit_work","1",before.Hex(),1);b:=p2p.WBFTTapBegin("worker_commit_work","1",before.Hex(),1)
 if a==nil||b==nil||a==b{t.Fatal("independent tokens absent")}
 result:=make(chan *types.Block,2);stop:=make(chan struct{});close(stop)
 backend.sealMu.Lock()
 if err:=backend.SealObserved(nil,block,result,stop,a);err!=nil{t.Fatal(err)}
 if err:=backend.SealObserved(nil,block,result,stop,b);err!=nil{t.Fatal(err)}
 select{case <-result:t.Fatal("return claimed asynchronous completion before lock release");default:}
 backend.sealMu.Unlock()
 for i:=0;i<2;i++{select{case received:=<-result:if received!=nil{t.Fatal("canceled result changed")};case <-time.After(5*time.Second):t.Fatal("missing original cancellation")}}
 for i:=0;i<2;i++{select{case e:=<-sub.Chan():if e.Data.(wbft.RequestEvent).Proposal!=block{t.Fatal("proposal pointer changed")};case <-time.After(5*time.Second):t.Fatal("missing original post")}}
 deadline:=time.Now().Add(5*time.Second);var data []byte
 for time.Now().Before(deadline){files,_:=filepath.Glob(filepath.Join(root,"observations-*.jsonl"));if len(files)==1{data,_=os.ReadFile(files[0]);if bytes.Count(data,[]byte(`"stage":"seal_cancel"`))==2&&bytes.Count(data,[]byte(`"stage":"request_post_return"`))==2{break}};time.Sleep(time.Millisecond)}
 if bytes.Count(data,[]byte(`"stage":"seal_cancel"`))!=2||block.Hash()!=before{t.Fatal("missing exact cancel or block changed")}
 ids:=map[uint64]int{}
 for _,line:=range bytes.Split(data,[]byte("\n")){var r struct{Type string `json:"type"`;ID uint64 `json:"id"`;Stage string `json:"stage"`};if json.Unmarshal(line,&r)==nil&&r.Stage=="seal_cancel"{ids[r.ID]++}}
 if len(ids)!=2{t.Fatal("same hash combined unrelated call IDs",ids)}
 a.End("returned","1",before.Hex(),0);b.End("returned","1",before.Hex(),0)
}

func TestWBFTTapActualCoreLifecycleAndDisabledReturns(t *testing.T) {
 // Each process owns one immutable capture writer, as the real node does.
 if os.Getenv("WBFT_TAP_LIFECYCLE_TEST")!="1" {
  cmd:=exec.Command(os.Args[0],"-test.run=^TestWBFTTapActualCoreLifecycleAndDisabledReturns$","-test.v")
  cmd.Env=append(os.Environ(),"WBFT_TAP_LIFECYCLE_TEST=1")
  if out,err:=cmd.CombinedOutput();err!=nil{t.Fatalf("isolated lifecycle: %v\n%s",err,out)}
  return
 }

 t.Setenv("WBFT_TAP_DIR","")
 chain,b,_:=newBlockChain(1)
 defer chain.Stop()
 defer b.broadcaster.(*fakeBroadcaster).blockFetcher.Stop()
 if err:=b.Stop();err!=nil{t.Fatal(err)}
 root:=t.TempDir();if err:=os.Chmod(root,0700);err!=nil{t.Fatal(err)}
 t.Setenv("WBFT_TAP_DIR",root);t.Setenv("WBFT_TAP_NODE",strings.ToLower(b.Address().Hex()))
 if err:=b.Start(chain,chain.CurrentFullBlock,rawdb.HasBadBlock,nil);err!=nil{t.Fatal(err)}
 if err:=b.Start(chain,chain.CurrentFullBlock,rawdb.HasBadBlock,nil);err!=wbft.ErrStartedEngine{t.Fatal("duplicate start changed",err)}
 if err:=b.Stop();err!=nil{t.Fatal(err)}
 if err:=b.Stop();err!=wbft.ErrStoppedEngine{t.Fatal("duplicate stop changed",err)}
 if err:=p2p.WBFTTapClose();err!=nil{t.Fatal(err)}
 files,_:=filepath.Glob(filepath.Join(root,"observations-*.jsonl"));if len(files)!=1{t.Fatal(files)}
 data,err:=os.ReadFile(files[0]);if err!=nil{t.Fatal(err)}
 stages:=map[string]int{};engines:=map[uint64]int{};parents:=map[uint64]string{}
 for _,line:=range bytes.Split(data,[]byte("\n")) {var r struct{Type string `json:"type"`;ID uint64 `json:"id"`;Parent uint64 `json:"parent_id"`;Stage string `json:"stage"`;Operation string `json:"operation"`};if json.Unmarshal(line,&r)!=nil{continue};switch r.Type{case "engine_created":engines[r.ID]++;case "operation_start":parents[r.ID]=r.Operation;case "engine_stage":if engines[r.ID]!=1{t.Fatal("wrong concrete instance")};want:="backend_start";switch r.Stage{case "stop_enter","timers_stopped","unsubscribed","handler_joined","stop_return":want="backend_stop"};if parents[r.Parent]!=want{t.Fatal("wrong exact parent",r)};stages[r.Stage]++}}
 if len(engines)!=1{t.Fatal("duplicate start created core",engines)}
 for _,s:=range []string{"start_enter","subscribed","handler_enter","initial_round_return","start_return","stop_enter","timers_stopped","unsubscribed","handler_exit","handler_joined","stop_return"}{if stages[s]!=1{t.Fatal(s,stages)}}
}

func TestWBFTTapRestartConfigurationKeepsDistinctInstances(t *testing.T) {
 if os.Getenv("WBFT_TAP_CONFIG_TEST")!="1" {
  cmd:=exec.Command(os.Args[0],"-test.run=^TestWBFTTapRestartConfigurationKeepsDistinctInstances$","-test.v")
  cmd.Env=append(os.Environ(),"WBFT_TAP_CONFIG_TEST=1")
  if out,err:=cmd.CombinedOutput();err!=nil{t.Fatalf("isolated restart: %v\n%s",err,out)}
  return
 }
 t.Setenv("WBFT_TAP_DIR","")
 chain,b,_:=newBlockChain(1);defer chain.Stop();defer b.broadcaster.(*fakeBroadcaster).blockFetcher.Stop()
 if err:=b.Stop();err!=nil{t.Fatal(err)}
 original:=chain.Genesis().Hash()
 restart:=func(){for i:=0;i<2;i++{b.config.AllowedFutureBlockTime=uint64(i+1);if err:=b.Start(chain,chain.CurrentFullBlock,rawdb.HasBadBlock,nil);err!=nil{t.Fatal(err)};if err:=b.Stop();err!=nil{t.Fatal(err)}}}
 restart()
 root:=t.TempDir();if err:=os.Chmod(root,0700);err!=nil{t.Fatal(err)}
 t.Setenv("WBFT_TAP_DIR",root);t.Setenv("WBFT_TAP_NODE",strings.ToLower(b.Address().Hex()))
 restart()
 if err:=p2p.WBFTTapClose();err!=nil{t.Fatal(err)}
 files,_:=filepath.Glob(filepath.Join(root,"observations-*.jsonl"));if len(files)!=1{t.Fatal(files)}
 data,err:=os.ReadFile(files[0]);if err!=nil{t.Fatal(err)}
 parents:=map[uint64]uint64{};configIDs:=map[uint64]bool{};values:=[]string{};startups:=0
 for _,line:=range bytes.Split(data,[]byte("\n")){
  var r struct{Type string `json:"type"`;ID uint64 `json:"id"`;Parent uint64 `json:"parent_id"`;Config struct{Value string `json:"AllowedFutureBlockSeconds"`} `json:"config"`}
  if json.Unmarshal(line,&r)!=nil{continue}
  switch r.Type{case "runtime_start":startups++;case "engine_created":parents[r.ID]=r.Parent;case "engine_config":if parents[r.ID]==0||parents[r.ID]!=r.Parent||configIDs[r.ID]{t.Fatal("wrong instance config",r)};configIDs[r.ID]=true;values=append(values,r.Config.Value)}
 }
 if len(configIDs)!=2||startups!=2||len(values)!=2||values[0]!="1"||values[1]!="2"||chain.Genesis().Hash()!=original{t.Fatal("restart snapshot lost or disabled behavior changed",values,startups)}
}
